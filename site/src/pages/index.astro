---
import { REPO, EXE } from "../site";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WC3 Grid Hotkeys</title>
    <meta
      name="description"
      content="Grid hotkeys for Warcraft III that keep Attack on A. Set your keys, then download CustomKeys.txt."
    />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
  </head>
  <body data-base={base}>
    <main>
      <div class="window">
        <p id="status">Loading…</p>
        <canvas id="canvas"></canvas>
      </div>
      <div class="touch-only">
        <h1>WC3 Grid Hotkeys</h1>
        <p>Made for a computer with a keyboard. Open this page on your PC.</p>
      </div>
      <p class="note">
        In game, set <em>Options &gt; Input &gt; Preset Keybindings</em> to Custom and restart.
      </p>
      <p class="note">
        <a href={EXE}>Windows app</a> (unsigned, so Windows may warn before it runs) ·{" "}
        <a href={REPO}>Source</a>
      </p>
    </main>

    <script>
      // Starts the WASM app (crates/web) with the bundled game files
      // (game.pack), both fetched at once. Touch-only devices (phones,
      // tablets) get a note instead: setting keys needs a keyboard.
      const base = document.body.dataset.base;
      const status = document.getElementById("status") as HTMLElement;
      const canvas = document.getElementById("canvas") as HTMLCanvasElement;

      async function main() {
        const [wasm, pack] = await Promise.all([
          import(/* @vite-ignore */ `${base}pkg/w3hk_web.js`).then(async (m) => {
            await m.default();
            return m;
          }),
          fetch(`${base}game.pack`).then((r) => {
            if (!r.ok) throw new Error(`game.pack: HTTP ${r.status}`);
            return r.arrayBuffer();
          }),
        ]);
        await wasm.start(canvas, new Uint8Array(pack));
        status.hidden = true;
        canvas.style.visibility = "visible";
        canvas.focus();
      }

      if (matchMedia("(hover: none) and (pointer: coarse)").matches) {
        document.body.classList.add("touch");
      } else {
        main().catch((e) => {
          status.textContent = `Couldn't start: ${e}`;
          status.classList.add("error");
        });
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    color-scheme: dark;
  }
  body {
    margin: 0;
    background: #0a0806;
    color: #8f8778;
    font: 13px/1.5 Georgia, "Times New Roman", serif;
  }
  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: safe center;
    justify-content: safe center;
    padding: 16px;
    overflow-x: auto;
  }
  /* The app's fixed window size. */
  .window {
    position: relative;
    width: 768px;
    height: 490px;
    flex: none;
    margin-bottom: 14px;
  }
  /* Hidden (but laid out, so it has a size) until the app has drawn. */
  #canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 6px;
    box-shadow: 0 8px 32px #000;
    visibility: hidden;
  }
  #status {
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
  }
  #status[hidden] {
    display: none;
  }
  .error {
    color: #ff6a4d;
  }
  .touch-only {
    display: none;
    text-align: center;
    max-width: 320px;
    margin-bottom: 24px;
  }
  .touch-only h1 {
    margin: 0 0 8px;
    color: #ffd428;
    font-size: 22px;
    text-transform: uppercase;
  }
  .touch-only p {
    margin: 0;
    font-size: 16px;
    color: #c9c0ae;
  }
  .touch .window {
    display: none;
  }
  .touch .touch-only {
    display: block;
  }
  .note {
    margin: 0;
    text-align: center;
  }
  a {
    color: #c9a34a;
  }
  a:hover {
    color: #ffd428;
  }
</style>
