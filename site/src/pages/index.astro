---
import { REPO, EXE, SHA, cards } from "../site";
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WC3 Grid Hotkeys</title>
    <meta
      name="description"
      content="Grid hotkeys for Warcraft III that keep Attack on A. One screen, one Apply button, generated from your installed game."
    />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}icon.png`} />
  </head>
  <body>
    <main>
      <header>
        <h1>WC3 Grid Hotkeys</h1>
        <p class="pitch">
          Grid hotkeys for Warcraft III that set themselves up from your installed game.
        </p>
      </header>

      <section class="download">
        <a class="btn" href={EXE}>Download for Windows</a>
        <p class="small">
          Run it, press Apply, then set <em>Options &gt; Input &gt; Preset Keybindings</em> to
          Custom and restart the game.
        </p>
        <p class="small">
          <a href={SHA}>SHA-256</a> · <a href={`${REPO}/releases`}>All releases</a>
        </p>
        <p class="small">
          Rather not run an exe? <a href={`${import.meta.env.BASE_URL}app/`}>Use it in your browser</a>.
        </p>
      </section>

      <section class="cards">
        {
          cards.map((card) => (
            <figure class="card">
              <figcaption>
                <h3>{card.title}</h3>
              </figcaption>
              <div class="board">
                {card.rows.flat().map((cell) =>
                  cell ? (
                    <div class:list={["cell", cell.mark]}>
                      <span class="key">{cell.key}</span>
                      <span class="name">{cell.name}</span>
                    </div>
                  ) : (
                    <div class="cell empty" />
                  ),
                )}
              </div>
            </figure>
          ))
        }
      </section>
    </main>

    <footer>
      <p>
        Free and open source (MIT or Apache-2.0) · <a href={REPO}>Source</a>
      </p>
      <p class="small">
        Not affiliated with or endorsed by Blizzard Entertainment. Warcraft is a trademark of
        Blizzard Entertainment, Inc.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  .download {
    text-align: center;
  }
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin: 20px 0;
  }
  .card {
    margin: 0;
    width: 260px;
    background: var(--panel);
    border: 2px solid var(--border);
    border-radius: 4px;
    padding: 12px;
    box-shadow: inset 0 0 0 1px #000, 0 4px 14px #0008;
  }
  .card h3 {
    margin: 0 0 10px;
    color: var(--gold);
    font-size: 1rem;
    text-align: center;
    text-shadow: 0 1px 2px #000;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .cell {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #000;
    border: 2px solid #2e2516;
    border-radius: 3px;
    text-align: center;
    padding: 2px;
  }
  .cell.empty {
    background: #0008;
  }
  .cell.good {
    border-color: var(--gold);
  }
  .cell.bad {
    border-color: #d22;
  }
  .cell .key {
    color: var(--gold);
    font-weight: bold;
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .cell .name {
    font-size: 0.62rem;
    line-height: 1.1;
    color: var(--muted);
  }
</style>
