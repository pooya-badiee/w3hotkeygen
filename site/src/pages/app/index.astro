---
import "../../styles.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WC3 Grid Hotkeys in your browser</title>
    <meta
      name="description"
      content="Grid hotkeys for Warcraft III, in your browser. Set your keys, then download CustomKeys.txt."
    />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
  </head>
  <body>
    <main id="w3hk" data-app={`${base}app/`}>
      <header>
        <h1>WC3 Grid Hotkeys</h1>
        <p class="pitch">The same app, in your browser. Set your keys, then download your keys file.</p>
      </header>

      <section class="screen">
        <p id="status" class="small">Loading…</p>
        <canvas id="canvas"></canvas>
        <p class="small">
          Put the downloaded <code>CustomKeys.txt</code> in <code>Documents\Warcraft III\CustomKeyBindings</code>{" "}
          (<code>OneDrive\Documents\…</code> if your Documents folder is in OneDrive), then in game set{" "}
          <em>Options &gt; Input &gt; Preset Keybindings</em> to Custom and restart the game.
        </p>
      </section>
    </main>

    <footer>
      <p><a href={base}>Download the Windows app</a> · Free and open source (MIT or Apache-2.0)</p>
      <p class="small">
        Not affiliated with or endorsed by Blizzard Entertainment. Warcraft is a trademark of Blizzard Entertainment,
        Inc.
      </p>
    </footer>

    <script>
      // Starts the WASM app (crates/web) with the bundled game files
      // (game.pack), both fetched at once.
      const root = document.getElementById("w3hk") as HTMLElement;
      const status = document.getElementById("status") as HTMLElement;
      const canvas = document.getElementById("canvas") as HTMLCanvasElement;
      const app = root.dataset.app;

      async function main() {
        const [wasm, pack] = await Promise.all([
          import(/* @vite-ignore */ `${app}pkg/w3hk_web.js`).then(async (m) => {
            await m.default();
            return m;
          }),
          fetch(`${app}game.pack`).then((r) => {
            if (!r.ok) throw new Error(`game.pack: HTTP ${r.status}`);
            return r.arrayBuffer();
          }),
        ]);
        await wasm.start(canvas, new Uint8Array(pack));
        status.hidden = true;
        canvas.style.visibility = "visible";
        canvas.focus();
      }

      main().catch((e) => {
        status.textContent = `Couldn't start: ${e}`;
        status.classList.add("error");
      });
    </script>
  </body>
</html>

<style is:global>
  code {
    font-size: 0.9em;
    color: var(--text);
  }
  .error {
    color: #ff6a4d;
  }
  .screen {
    text-align: center;
    overflow-x: auto;
  }
  /* The app's fixed window size. Hidden (but laid out, so it has a size)
     until the app has drawn. */
  #canvas {
    width: 768px;
    height: 490px;
    display: block;
    margin: 0 auto;
    border-radius: 6px;
    box-shadow: 0 6px 24px #000c;
    visibility: hidden;
  }
</style>
